generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum CampaignStatus {
  DRAFT
  PENDING
  QUEUED
  PROCESSING
  RUNNING
  PAUSED
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum MessageStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum DomainStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  TRANSFERRED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PAID
  CANCELLED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(ADMIN)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -------------------------------------------------------------
// DTS SUBSCRIBER & CRM MODELS
// -------------------------------------------------------------
model Subscriber {
  id            String            @id @default(cuid())
  name          String
  phone         String            @unique
  email         String?
  company       String?
  notes         String?
  channels      Json?             @default("[\"WhatsApp\"]") // WhatsApp, SMS, E-Posta, Sesli Arama
  preferredTime String?           @default("08:00")
  language      String?           @default("TR")
  isActive      Boolean           @default(true)
  isInteractive Boolean           @default(false)
  isBlacklisted Boolean           @default(false)
  avatar        String?
  isCustomName  Boolean           @default(false)
  lastSentAt    DateTime?
  customFields  Json?             @default("{}")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  groups        SubscriberGroup[]
  domains       Domain[]
  orders        Order[]
  notifications NotificationLog[]

  @@index([phone])
}

model SubscriberGroup {
  id           String     @id @default(cuid())
  subscriberId String
  groupId      String
  createdAt    DateTime   @default(now())

  subscriber   Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  group        Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([subscriberId, groupId])
}

// -------------------------------------------------------------
// DTS DOMAIN & HOSTING MANAGEMENT
// -------------------------------------------------------------
model Domain {
  id            String       @id @default(cuid())
  name          String       @unique // e.g. "cakirlar.net"
  subscriberId  String?
  subscriber    Subscriber?  @relation(fields: [subscriberId], references: [id], onDelete: SetNull)
  registrar     String?      @default("METUNIC") // METUNIC, IHS, Natro, GoDaddy vb.
  expiryDate    DateTime
  sslExpiryDate DateTime?
  autoRenew     Boolean      @default(false)
  status        DomainStatus @default(ACTIVE)
  price         Float?       @default(250)
  currency      String?      @default("TL")
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  orders        Order[]
  notifications NotificationLog[]

  @@index([name])
  @@index([expiryDate])
}

// -------------------------------------------------------------
// DTS ORDERS & OFFERS
// -------------------------------------------------------------
model Order {
  id           String      @id @default(cuid())
  orderNumber  String      @unique // e.g. "DTS-2026-001"
  subscriberId String?
  subscriber   Subscriber? @relation(fields: [subscriberId], references: [id], onDelete: SetNull)
  domainId     String?
  domain       Domain?     @relation(fields: [domainId], references: [id], onDelete: SetNull)
  title        String
  amount       Float
  currency     String      @default("TL")
  status       OrderStatus @default(PENDING)
  items        Json?       @default("[]")
  validUntil   DateTime?
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

// -------------------------------------------------------------
// NOTIFICATION & DELIVERY LOGS
// -------------------------------------------------------------
model NotificationLog {
  id           String      @id @default(cuid())
  subscriberId String?
  subscriber   Subscriber? @relation(fields: [subscriberId], references: [id], onDelete: SetNull)
  domainId     String?
  domain       Domain?     @relation(fields: [domainId], references: [id], onDelete: SetNull)
  channel      String      @default("WhatsApp") // WhatsApp, SMS, E-Posta, Sesli
  type         String      @default("DOMAIN_RENEWAL")
  status       String      @default("SENT") // SENT, DELIVERED, FAILED
  recipient    String
  content      String
  error        String?
  sentAt       DateTime    @default(now())
  createdAt    DateTime    @default(now())

  @@index([recipient])
  @@index([status])
}

// -------------------------------------------------------------
// SYSTEM CONFIGURATION & COMPATIBILITY
// -------------------------------------------------------------
model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

// Backward Compatibility with Contact & Campaign Models
model Contact {
  id            String         @id @default(cuid())
  name          String
  phone         String         @unique
  email         String?
  notes         String?
  isBlacklisted Boolean        @default(false)
  avatar        String?
  isCustomName  Boolean        @default(false)
  customFields  Json?          @default("{}")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  groups        ContactGroup[]
  messages      Message[]

  @@index([phone])
}

model Group {
  id          String            @id @default(cuid())
  name        String            @unique
  description String?
  color       String?           @default("#10b981")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  contacts    ContactGroup[]
  subscribers SubscriberGroup[]
}

model ContactGroup {
  id        String   @id @default(cuid())
  contactId String
  groupId   String
  createdAt DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  group   Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([contactId, groupId])
}

model Template {
  id        String     @id @default(cuid())
  name      String
  content   String
  mediaType String?
  mediaUrl  String?
  variables Json?      @default("[]")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  campaigns Campaign[]
}

model Campaign {
  id          String         @id @default(cuid())
  title       String
  templateId  String?
  template    Template?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  status      CampaignStatus @default(DRAFT)
  totalCount  Int            @default(0)
  sentCount   Int            @default(0)
  failedCount Int            @default(0)
  minDelay    Int            @default(8)
  maxDelay    Int            @default(20)
  batchSize   Int            @default(25)
  batchPause  Int            @default(60)
  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  messages    Message[]
}

model Message {
  id                 String        @id @default(cuid())
  campaignId         String?
  campaign           Campaign?     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId          String?
  contact            Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  phone              String
  content            String
  mediaUrl           String?
  mediaType          String?
  status             MessageStatus @default(QUEUED)
  evolutionMessageId String?
  errorMessage       String?
  sentAt             DateTime?
  deliveredAt        DateTime?
  readAt             DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([phone])
  @@index([status])
  @@index([campaignId])
}

model Blacklist {
  id        String   @id @default(cuid())
  phone     String   @unique
  reason    String?  @default("Kullanıcı talebi (Opt-Out)")
  addedBy   String?  @default("Auto-Keyword")
  createdAt DateTime @default(now())

  @@index([phone])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

// -------------------------------------------------------------
// HIKMETNAME SPECIAL DAYS & HADITH ARCHIVE
// -------------------------------------------------------------
model SpecialDay {
  id          String   @id @default(cuid())
  title       String
  hijriDate   String?
  miladiDate  DateTime
  targetGroup String?  @default("Tüm Aboneler")
  status      String   @default("PLANLANDI")
  content     String
  hasAudio    Boolean  @default(false)
  audioUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Hadith {
  id        String   @id @default(cuid())
  arabic    String
  turkish   String
  source    String?
  category  String?  @default("Genel Hikmet")
  tags      Json?    @default("[]")
  audioUrl  String?
  createdAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
